# Local value template for a checkout of this project. Portable configuration lives under
# config/*.toml. This file carries the local placeholders and the editable machine-local worker
# values.
POSTGRES_PASSWORD=replace-with-local-secret
TRANSLATION_CONTROLLER_SSH_TARGET=replace-with-ssh-target
TRANSLATION_CONTROLLER_WSL_DISTRIBUTION=replace-with-wsl-distribution
TRANSLATION_CONTROLLER_WORKER_PROJECT_ROOT=/home/replace-with-user/tuni-course-explorer
