# Local credential placeholders for a checkout. Non-secret settings live under config/.
POSTGRES_PASSWORD=replace-with-local-secret
# Local password for the feedback application store that config/feedback.toml names.
FEEDBACK_POSTGRES_PASSWORD=replace-with-local-secret
# Per-device GitHub token that only the feedback sender reads. The destination repository lives in
# config/feedback.toml.
FEEDBACK_GITHUB_TOKEN=replace-with-local-secret
