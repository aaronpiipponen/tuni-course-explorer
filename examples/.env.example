# Local placeholders for machine-specific checkout configuration values.
POSTGRES_PASSWORD=replace-with-local-secret
TRANSLATION_CONTROLLER_SSH_TARGET=replace-with-ssh-target
TRANSLATION_CONTROLLER_WSL_DISTRIBUTION=replace-with-wsl-distribution
TRANSLATION_CONTROLLER_WORKER_PROJECT_ROOT=/home/replace-with-user/tuni-course-explorer
# The systemd unit basename this checkout's web process runs as, and its manager: `user` or
# `system`. The unit value ends in `.service`.
ADMIN_SITE_WEB_SERVICE_UNIT=replace-with-web.service
ADMIN_SITE_WEB_SERVICE_SCOPE=user
# The systemd user unit basename this checkout's administration process runs as. The value ends in
# `.service`, and the administration process always uses the user manager.
ADMIN_SITE_ADMIN_SERVICE_UNIT=replace-with-admin.service
