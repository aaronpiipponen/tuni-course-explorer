# Example service configuration for the web UI.
[Unit]
Description=TUNI Course Explorer web UI

[Service]
Type=simple
WorkingDirectory=@CHECKOUT@
ExecStart=/usr/bin/bash @CHECKOUT@/scripts/run_web.sh
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077
Nice=5
StandardOutput=null
StandardError=journal

[Install]
WantedBy=default.target
