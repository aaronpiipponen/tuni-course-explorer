# HTTPS course-exploration site and administration site with separate interface binds.
{
	admin off
	auto_https disable_redirects
}

https://{$COURSE_EXPLORER_PUBLIC_DOMAIN} {
	bind {$COURSE_EXPLORER_PUBLIC_BIND}
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	reverse_proxy 127.0.0.1:8037
}

https://{$COURSE_EXPLORER_ADMIN_DOMAIN} {
	bind {$COURSE_EXPLORER_ADMIN_BIND}
	tls {
		issuer acme {
			disable_http_challenge
			disable_tlsalpn_challenge
			dns duckdns {env.DUCKDNS_API_TOKEN}
		}
	}
	reverse_proxy 127.0.0.1:8039
}
