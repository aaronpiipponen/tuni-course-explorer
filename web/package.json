{
  "name": "tuni-course-explorer-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || >=24.15.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "solver:build": "vite build --ssr src/solver/cli.ts --outDir .solver-cli --emptyOutDir",
    "test": "vitest run && node --test tools/wiki/build.test.mjs",
    "format:check": "prettier --check .",
    "browser:install": "playwright install chromium --only-shell",
    "browser:test": "cd .. && uv run python -m tests.web.browser_runner"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tanstack/react-virtual": "3.14.22",
    "@xyflow/react": "12.12.0",
    "elkjs": "0.12.0",
    "framer-motion": "14.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "unist-util-visit": "5.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "github-slugger": "2.0.0",
    "jsdom": "30.1.3",
    "mdast-util-to-string": "4.0.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "rehype-highlight": "7.0.2",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
